{
  "name": "loopnote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:integration": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "env:check": "tsx scripts/env-check.ts",
    "tokens:contrast": "pnpm --filter @loopnote/tokens tokens:contrast",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm typecheck:integration && pnpm lint && pnpm env:check && pnpm tokens:contrast && pnpm format:check && pnpm test",
    "verify:full": "pnpm verify && pnpm test:integration && pnpm e2e"
  },
  "devDependencies": {
    "@loopnote/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
