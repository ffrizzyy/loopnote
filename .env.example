# Copy this file to .env and fill in real values. The server loads it on
# startup (server/src/index.ts); variables already set in the real
# environment take precedence over anything here.
#
# Vars marked "(planned)" aren't read by any code yet — they're reserved so the
# next issues (job queue, real detection/summarization calls) don't need to
# re-touch this file.
#
# The client does NOT read this file: Expo only loads .env from its own
# project directory. See client/.env.example.

# --- Server (active) ---
NODE_ENV=development
PORT=4000
# Where uploaded images are written, keyed by content hash. Defaults to a
# tmp dir if unset — set this to persist across restarts. Relative paths
# resolve against the directory the server is started from, which is
# server/ for `npm run dev:server`.
IMAGES_DIR=./data/images
# SQLite via better-sqlite3 (see "Design data model & persistence") — a
# deliberate choice for a solo/small-team MVP, not just a test convenience.
# Unset means ":memory:" (which is what tests use): nothing survives a
# restart. Same relative-path rule as IMAGES_DIR. Revisit only if/when
# write concurrency or multi-instance deployment actually demands a
# client-server DB.
DATABASE_URL=file:./data/loopnote.db

# --- Server (planned — job queue / object storage) ---
REDIS_URL=redis://localhost:6379
STORAGE_BUCKET=loopnote-dev-images
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Server (planned — AI pipeline) ---
# Detection/OCR and summarization calls are mocked for now; this key isn't
# read until the real Anthropic calls are wired up.
ANTHROPIC_API_KEY=
