{
  "expo": {
    "name": "Loopnote",
    "slug": "loopnote",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loopnote.app"
    },
    "android": {
      "package": "com.loopnote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Loopnote needs access to your photos so you can import notes and whiteboard photos."
        }
      ]
    ]
  }
}
