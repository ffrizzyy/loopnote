# Copy this file to client/.env. Expo loads .env from the client project
# directory only — the repo-root .env is not seen by the app.

# Default server address the app starts with. It's also editable at runtime
# in the app's "Server address" field, so this is a convenience, not a
# requirement. On a physical device use your computer's LAN IP, not
# localhost (which would mean the phone itself).
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
